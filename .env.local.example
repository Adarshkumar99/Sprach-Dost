# SprachDost — environment variables (all optional / free-tier friendly)
#
# Copy this file to .env.local for local development.
# On Vercel: add the same names under Project Settings → Environment Variables.

# Free LLM for conversations (Anna scenarios + Lehrer). Without it the client
# shows setup instructions and no AI calls are made.
GROQ_API_KEY=

# Optional Groq model override (Groq retires models over time).
# Example: GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL=

# Optional premium neural voices (human-like). Without it, the free browser
# voices are used automatically.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional auth + cloud progress sync (Supabase free tier).
# Create a project at supabase.com → Settings → API, then run supabase/schema.sql
# in the SQL Editor once. Without these, the app stays 100% local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY: lets the Stripe webhook update profiles.is_pro (never expose!)
SUPABASE_SERVICE_ROLE_KEY=

# ── SprachDost Pro (Stripe) — free tier works without these ──
# 1. stripe.com → get secret key
# 2. Create a product + recurring price (₹500/mo) → copy price ID (price_...)
# 3. stripe listen --forward-to localhost:3000/api/stripe/webhook → copy whsec_...
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Public URL of the deployed site (used for checkout redirects)
NEXT_PUBLIC_SITE_URL=

# ── Android app (Capacitor) ──
# The URL the Android WebView loads — set this to your deployed site.
CAP_SERVER_URL=

# ── Daily Word-of-the-Day push (optional) ──
# Generate a key pair once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@example.com
# Secret that protects /api/push/cron (Vercel sends it as Bearer token; set the
# same value in Vercel env var CRON_SECRET)
CRON_SECRET=

